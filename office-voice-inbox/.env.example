# Copy to ~/.config/office-voice-inbox/.env (never commit the real one).
# If ASSEMBLYAI_API_KEY is unset, the key is read from the Obsidian note at
# APIS_MD_PATH (the line mentioning AssemblyAI). Values are never printed.

#ASSEMBLYAI_API_KEY=
#APIS_MD_PATH=~/Desktop/Macbook Air/APIs.md

# Where clips / daily markdown / state live
#VOICE_INBOX_HOME=~/OfficeVoiceInbox

# Mic: name substring or index from `voice-inbox devices` (default: system default)
#INPUT_DEVICE=

# VAD / burst tuning
#VAD_AGGRESSIVENESS=2        # 0 (loose) .. 3 (strict)
#BURST_END_SILENCE_MS=1500   # this much hush ends a burst
#MIN_VOICED_MS=600           # shorter bursts (keyboard clicks) are dropped
#MAX_BURST_SECONDS=600       # force-split monologues longer than this
#CLIP_RETENTION_DAYS=3       # gated clips kept locally this long, then deleted

# Drive delivery: docs (Google Docs API), rclone (sync daily .md), off (local only)
#DRIVE_BACKEND=docs
#DRIVE_FOLDER_NAME=Office Voice Inbox
#RCLONE_REMOTE=gdrive

#TIMEZONE=America/Chicago
